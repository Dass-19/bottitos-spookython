{
  "family": "mantazero",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "mantazero-container",
      "image": "028610956449.dkr.ecr.us-east-1.amazonaws.com/mantazero:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mantazero",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "OLLAMA_MODEL",
          "value": "nemotron-3-ultra"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::028610956449:role/ecsTaskExecutionRole",
  "tags": [
    {
      "key": "Project",
      "value": "MantaZero"
    },
    {
      "key": "Event",
      "value": "Spookython2026"
    }
  ]
}
